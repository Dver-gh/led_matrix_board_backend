# MQTT Broker Config
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Single topic the ESP32 firmware subscribes to; the `mode` field selects weather vs spotify.
MQTT_TOPIC=home/led/display/state

# OpenWeather API Config
OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_CITY=Wroclaw

# Spotify API Config (headless refresh-token flow)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Obtained once via the interactive authorization-code flow; used headlessly thereafter.
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
